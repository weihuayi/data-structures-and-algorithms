# ============================================================
# Suanhai standard repository .gitignore
# Default baseline for why repo create
#
# Design intent:
# - conservative and usable by default
# - ignore local/generated/temp artifacts first
# - avoid aggressively ignoring potentially shareable project files
# ============================================================

# OS / filesystem artifacts
.DS_Store
__MACOSX/
.AppleDouble
.LSOverride
Icon[]
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump

# Generic editor / shell temp files
*~
*.swp
*.swo
.nfs*

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace
*.vsix

# JetBrains
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/aws.xml
.idea/**/contentModel.xml

# Visual Studio / Rider local state
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
mono_crash.*

# Environment / local secrets
.env
.env.*
!.env.example
!.env.sample

# Python
__pycache__/
*.py[codz]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints
.Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/
.pdm-python
.pdm-build/
.pixi/
dist/
.eggs/
*.egg-info/
pip-wheel-metadata/

# C / C++ / native build outputs
*.d
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.ilk
*.pdb
*.dwo
*.so
*.so.*
*.dylib
*.dll
*.a
*.la
*.lai
*.lib
*.exe
*.out
*.app

# CMake / native build / install artifacts
build/
Build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
Testing/
.cache/
vcpkg_installed/

# Generic logs / temp
*.log
*.tmp
*.bak

# The third party repos
repos/*
!repos/README.md
!repos/repo_manifest.yaml
